{
  "name": "agent-pr-reviewer-lite",
  "version": "0.1.0",
  "description": "Deterministic PR risk reviewer for agent-generated code changes.",
  "type": "module",
  "bin": {
    "agent-pr-reviewer-lite": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent-pr-reviewer-lite": "tsx src/cli.ts",
    "pr:risk": "tsx src/cli.ts --base main --head HEAD --fail-on high"
  },
  "keywords": [
    "agent",
    "ai-code",
    "pull-request",
    "ci",
    "risk",
    "security",
    "static-analysis"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.15.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
