{
  "name": "agent-pr-reviewer-lite",
  "version": "0.1.0",
  "description": "Deterministic PR risk reviewer for agent-generated code changes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "agent-pr-reviewer-lite": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pr:risk": "tsx src/cli.ts --base main --head HEAD --fail-on high",
    "smoke:tarball": "bash scripts/tarball-smoke.sh"
  },
  "keywords": [
    "agent",
    "ai-code",
    "pull-request",
    "ci",
    "risk",
    "security",
    "static-analysis",
    "ai-agents",
    "agent-review",
    "deterministic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alipajand/agent-pr-reviewer-lite.git"
  },
  "bugs": {
    "url": "https://github.com/alipajand/agent-pr-reviewer-lite/issues"
  },
  "homepage": "https://github.com/alipajand/agent-pr-reviewer-lite#readme",
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "0.28.1",
    "prettier": "^3.9.4",
    "tsx": "^4.15.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
