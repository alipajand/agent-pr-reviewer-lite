{
  "name": "agent-pr-reviewer-lite",
  "version": "0.1.0",
  "description": "Deterministic PR risk reviewer for agent-generated code changes.",
  "type": "module",
  "bin": {
    "agent-pr-reviewer-lite": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent-pr-reviewer-lite": "tsx src/cli.ts",
    "pr:risk": "tsx src/cli.ts --base main --head HEAD --fail-on high"
  },
  "keywords": [
    "agent",
    "ai-code",
    "pull-request",
    "ci",
    "risk",
    "security",
    "static-analysis"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
